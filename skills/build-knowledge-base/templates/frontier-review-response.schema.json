{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swiss TIP frontier review response",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "reason"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "reject", "escalate"]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
